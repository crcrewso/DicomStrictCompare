<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The workflow the three front-end prototypes share, so that they differ only in their UI layer:
    read two folders of RT files, match the doses by UID (or identifier), run each Dta over the
    matched pairs through DSClibrary's BatchComparer, and write the result as a spreadsheet (CSV).
    Nothing here draws anything. crane-dsc, 2026-11-08.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The view model the Avalonia prototype uses. Eto does not use it. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The difference viewer's page and NiiVue (BSD-2, Viewer/assets/NIIVUE-LICENSE.txt), served by ViewerServer. -->
    <None Include="Viewer\viewer.html;Viewer\assets\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DSClibrary\DSClibrary.csproj" />
    <!-- The profile figure, so the windows show and save the same one as DSCprofiles. It draws only when asked. -->
    <ProjectReference Include="..\..\DSCplots\DSCplots.csproj" />
  </ItemGroup>

</Project>
