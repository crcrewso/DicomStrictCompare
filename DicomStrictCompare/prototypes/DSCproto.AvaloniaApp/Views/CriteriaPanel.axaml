<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DSCprototypes.Shared.ViewModels"
             xmlns:shared="using:DSCprototypes.Shared"
             xmlns:views="using:DSCproto.AvaloniaApp.Views"
             x:Class="DSCproto.AvaloniaApp.Views.CriteriaPanel"
             x:DataType="vm:MainViewModel">

  <!-- The criteria list and Max: one list, shown beside both Doses vs doses and Study, which compare at it
       (crane, 2026-11-17, when Study became a tab of its own). Editing it in either tab changes it in both. Hover text
       comes from HelpText, which the Eto window shares. -->
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding $parent[views:CriteriaPanel].Title}" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
      <TextBlock Text="Max" VerticalAlignment="Center" ToolTip.Tip="{x:Static shared:HelpText.Maximum}"/>
      <ComboBox ItemsSource="{Binding MaximumChoices}" SelectedItem="{Binding Maximum}" MinWidth="130"
                ToolTip.Tip="{x:Static shared:HelpText.Maximum}"/>
      <!-- GPU float, also kept with a study, is on the Settings tab since 2026-11-17, beside the engine it applies to. -->
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
      <Button Content="Add" Command="{Binding AddCriterionCommand}"/>
      <Button Content="Remove" Command="{Binding RemoveCriterionCommand}"/>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Criteria}" SelectedItem="{Binding SelectedCriterion}"
              AutoGenerateColumns="False" CanUserReorderColumns="False" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding TolerancePercent}" Width="*" MinWidth="70">
          <DataGridTextColumn.Header><TextBlock Text="Tol %" ToolTip.Tip="{x:Static shared:HelpText.Tolerance}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding DistanceMm}" Width="*" MinWidth="90">
          <DataGridTextColumn.Header><TextBlock Text="DTA mm" ToolTip.Tip="{x:Static shared:HelpText.Distance}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding ThresholdPercent}" Width="*" MinWidth="70">
          <DataGridTextColumn.Header><TextBlock Text="Thr %" ToolTip.Tip="{x:Static shared:HelpText.Threshold}"/></DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridCheckBoxColumn Binding="{Binding Global}" Width="Auto">
          <DataGridCheckBoxColumn.Header><TextBlock Text="Global" ToolTip.Tip="{x:Static shared:HelpText.Global}"/></DataGridCheckBoxColumn.Header>
        </DataGridCheckBoxColumn>
        <DataGridCheckBoxColumn Binding="{Binding Gamma}" Width="Auto">
          <DataGridCheckBoxColumn.Header><TextBlock Text="Gamma" ToolTip.Tip="{x:Static shared:HelpText.Gamma}"/></DataGridCheckBoxColumn.Header>
        </DataGridCheckBoxColumn>
        <DataGridTemplateColumn Width="Auto">
          <DataGridTemplateColumn.Header><TextBlock Text="Applies to" ToolTip.Tip="{x:Static shared:HelpText.AppliesTo}"/></DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CriterionViewModel">
              <ComboBox ItemsSource="{x:Static vm:CriterionViewModel.AppliesToChoices}" SelectedItem="{Binding AppliesTo}"
                        HorizontalAlignment="Stretch" ToolTip.Tip="{x:Static shared:HelpText.AppliesTo}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
