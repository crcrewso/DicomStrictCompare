<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DSCprototypes.Shared.ViewModels"
        xmlns:views="using:DSCproto.AvaloniaApp.Views"
        xmlns:shared="using:DSCprototypes.Shared"
        xmlns:graphs="using:DSCprototypes.Shared.Graphs"
        xmlns:studies="using:DSCprototypes.Shared.Studies"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="DSCproto.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DicomStrictCompare - Avalonia prototype"
        Width="1280" Height="820" MinWidth="900" MinHeight="600">

  <!-- Compiled bindings throughout: a typo in a binding path is a build error, not a blank control. -->

  <Window.Styles>
    <!-- The splitters between panels. Avalonia's default template is transparent, so the grab area was an invisible
         8 px gap (crcrewso, 2026-11-09: "is there a way to make the part one can grab visible"). A light bar with a
         grip in the middle, the usual sash look. -->
    <Style Selector="GridSplitter.sash">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4">
            <Border Width="2" Height="36" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>

  <!-- One tab per kind of comparison (crcrewso, 2026-11-17), each with its own inputs, run and results: dose against
       dose, with two dose folders and the 3D criteria; a study, with its dose sets and the same criteria list; and
       doses against water-tank scans, with a doses folder, a scans folder and a 1D criterion. -->
  <!-- Last, Settings: this machine's engine, threads and reading, for every tab that compares doses. -->
  <TabControl x:Name="Workflows" Margin="6,6,6,0">
  <TabItem Header="Doses vs doses" x:Name="DosesTab">
  <Grid RowDefinitions="Auto,*,Auto" Margin="6,12,6,12">

    <!-- Inputs: two folders, two aliases, the matching strategy -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,180,Auto,140" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Source (reference)" VerticalAlignment="Center"/>
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SourceFolder}" PlaceholderText="Folder of RT Dose and RT Plan files"/>
      <Button Grid.Row="0" Grid.Column="2" Content="Browse" Command="{Binding BrowseSourceCommand}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Alias" VerticalAlignment="Center"/>
      <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SourceAlias}"/>
      <TextBlock Grid.Row="0" Grid.Column="5" Text="Algorithm" VerticalAlignment="Center"/>
      <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding SourceAlgorithm}" PlaceholderText="if names lack it"
               ToolTip.Tip="For doses whose plan label and beam name name no algorithm (Settings, Algorithm names). AAA pairs only with AAA; unknown only with unknown."/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Target" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetFolder}" PlaceholderText="Folder of RT Dose and RT Plan files"/>
      <Button Grid.Row="1" Grid.Column="2" Content="Browse" Command="{Binding BrowseTargetCommand}"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Alias" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding TargetAlias}"/>
      <TextBlock Grid.Row="1" Grid.Column="5" Text="Algorithm" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding TargetAlgorithm}" PlaceholderText="if names lack it"
               ToolTip.Tip="For doses whose plan label and beam name name no algorithm (Settings, Algorithm names). AAA pairs only with AAA; unknown only with unknown."/>

      <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="6" Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Match doses by" VerticalAlignment="Center"/>
        <RadioButton Content="plan UID and beam name" IsChecked="{Binding MatchByPlanUidAndBeamName}" GroupName="match"/>
        <RadioButton Content="plan label and beam name" IsChecked="{Binding MatchByPlanLabelAndBeamName}" GroupName="match"/>
        <RadioButton Content="patient, plan label and beam name" IsChecked="{Binding MatchByIdentifier}" GroupName="match"/>
      </StackPanel>
    </Grid>

    <!-- Work area: criteria on the left, results in tabs on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="340,8,*" Margin="0,12,0,0">

      <views:CriteriaPanel Grid.Column="0" Title="Criteria (the Study tab uses this list too)"/>

      <!-- The splitter between criteria and results (the sash style above). -->
      <GridSplitter Grid.Column="1" Classes="sash" ResizeDirection="Columns" Width="8" Margin="0,4" ToolTip.Tip="Drag to resize the criteria panel"/>

      <TabControl Grid.Column="2" x:Name="Tabs">
        <TabItem Header="Results">
          <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*"/>
              <DataGridTextColumn Header="Criterion" Binding="{Binding Criterion.Label}" Width="*"/>
              <DataGridTextColumn Header="Ambiguous" Binding="{Binding WorstOf}" Width="Auto"/>
              <DataGridTextColumn Header="Max used" Binding="{Binding MaximumUsed}" Width="Auto"/>
              <DataGridTextColumn Header="Edge check" Binding="{Binding EdgeCheck}" Width="Auto"/>
              <DataGridTextColumn Header="Compared" Binding="{Binding Compared, StringFormat=N0}" Width="Auto"/>
              <DataGridTextColumn Header="Failed" Binding="{Binding Failed, StringFormat=N0}" Width="Auto"/>
              <DataGridTextColumn Header="% failed" Binding="{Binding PercentFailed, StringFormat=0.000}" Width="Auto"/>
              <DataGridTextColumn Header="Max γ" Binding="{Binding MaxGamma, StringFormat=0.00}" Width="Auto"/>
              <DataGridTextColumn Header="Src MU" Binding="{Binding SourceMonitorUnits}" Width="Auto"/>
              <DataGridTextColumn Header="Tgt MU" Binding="{Binding TargetMonitorUnits}" Width="Auto"/>
              <DataGridTextColumn Header="s" Binding="{Binding ElapsedSeconds, StringFormat=0.0}" Width="Auto"/>
              <DataGridTextColumn Header="Failure" Binding="{Binding Failure}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Unmatched">
          <ListBox ItemsSource="{Binding Unmatched}"/>
        </TabItem>
        <TabItem Header="Log">
          <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace"/>
        </TabItem>
        <!-- Graphs (crcrewso, 2026-11-09): curves out of the matched pairs of the last run, filtered by energy
             and field size, a depth dose or a profile at a depth chosen with the slider. The view model
             owns the choice and the curve; this view only hands the curve to ScottPlot (code-behind).
             Water-tank scans have their own tab, Doses vs scans, since 2026-11-17. -->
        <TabItem Header="Graphs">
          <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="6" Margin="0,6,0,0"
                DataContext="{Binding Graph}" x:DataType="vm:GraphViewModel">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Energy" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergy}" MinWidth="150" IsEnabled="{Binding HasBeams}"/>
              <TextBlock Text="Field size" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding FieldSizes}" SelectedItem="{Binding SelectedFieldSize}" MinWidth="150" IsEnabled="{Binding HasBeams}"/>
              <TextBlock Text="Beam" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Beams}" SelectedItem="{Binding SelectedBeam}" MinWidth="360" IsEnabled="{Binding HasBeams}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="graphs:BeamDescriptor">
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="120" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Curve" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" MinWidth="150" IsEnabled="{Binding HasBeams}"/>
              <TextBlock Text="Depth" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <ComboBox ItemsSource="{Binding DepthChoices}" SelectedItem="{Binding Depth}" MinWidth="130" IsEnabled="{Binding DepthEnabled}"/>
              <TextBlock Text="{Binding DepthText}" VerticalAlignment="Center" MinWidth="70"/>
              <TextBlock Text="Depths offered" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBox Text="{Binding DepthsText}" Width="220" ToolTip.Tip="For example: dmax, 15, 50, 100, 200, 300 mm (cm also accepted)"/>
            </StackPanel>
            <sp:AvaPlot Grid.Row="2" x:Name="GraphPlot"/>
            <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="4" Text="{Binding ConventionNote}" TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>
          </Grid>
        </TabItem>
        <TabItem Header="Detector geometry">
          <TextBlock Margin="12" TextWrapping="Wrap"
                     Text="Placeholder: detector geometry correction for PTW scans. IDetectorCorrection exists in DSClibrary; no physical kernel is implemented yet (backlog D4), so there is nothing honest to switch on here."/>
        </TabItem>
        <TabItem Header="Archive">
          <TextBlock Margin="12" TextWrapping="Wrap"
                     Text="Placeholder: PNG export of each comparison for the record (an archiving output, not a display mechanism - crcrewso, 2026-11-08). Rendered from the retained ComparisonOutcome, independent of this window."/>
        </TabItem>

      </TabControl>
    </Grid>

    <!-- Actions and status -->
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Run comparison" Command="{Binding RunCommand}" Classes="accent"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        <Button Content="Export spreadsheet (CSV)" Command="{Binding ExportCommand}"/>
      </StackPanel>
      <ProgressBar DockPanel.Dock="Right" IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Width="160" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
  </TabItem>

  <!-- Study (design/comparison-studies.md, 2026-11-14): several dose sets and the comparisons
       between them. F1 sets, F2 pairing rules and preview, F3/F4 checks on every row, F5 results
       and index tables, F7 every set's curves at the study's depths. Uses the Criteria list. -->
  <!-- Its own tab since 2026-11-17 (crcrewso: "move the Study tab out too"): a study has its own dose sets, so the
       Doses vs doses folder boxes did nothing for it. It still compares at the shared criteria list, shown beside it. -->
  <TabItem Header="Study">
    <Grid ColumnDefinitions="340,8,*" Margin="6,12,6,12">
      <views:CriteriaPanel Grid.Column="0" Title="Criteria (the Doses vs doses tab uses this list too)"/>
      <GridSplitter Grid.Column="1" Classes="sash" ResizeDirection="Columns" Width="8" Margin="0,4" ToolTip.Tip="Drag to resize the criteria panel"/>
      <Grid Grid.Column="2" DataContext="{Binding Study}" x:DataType="vm:StudyViewModel" RowDefinitions="*,Auto" Margin="0,6,0,0">
        <TabControl Grid.Row="0">

          <TabItem Header="Setup">
            <Grid RowDefinitions="Auto,2*,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Text="Dose sets: a folder of RT Dose and RT Plan files each, under a name you choose" FontWeight="SemiBold"/>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}"
                        AutoGenerateColumns="False" CanUserReorderColumns="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                  <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*"/>
                  <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" Width="*"/>
                  <DataGridTextColumn Header="TPS" Binding="{Binding TpsVersion}" Width="*"/>
                  <DataGridTemplateColumn Header="Dose reported as" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:DoseSetViewModel">
                        <ComboBox ItemsSource="{x:Static vm:DoseSetViewModel.ReportingChoices}" SelectedItem="{Binding Reporting}" HorizontalAlignment="Stretch"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Plan filter (regex)" Binding="{Binding PlanFilter}" Width="*"/>
                  <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Add set" Command="{Binding AddSetCommand}"/>
                <Button Content="Remove set" Command="{Binding RemoveSetCommand}"/>
                <Button Content="Browse folder for the selected set" Command="{Binding BrowseSetFolderCommand}"/>
              </StackPanel>

              <TextBlock Grid.Row="3" Margin="0,8,0,0" FontWeight="SemiBold"
                         Text="Comparisons. Rules: 'pattern -> replacement; ...' (regular expressions). Overrides: 'source label = target label; ...'"/>
              <DataGrid Grid.Row="4" ItemsSource="{Binding Comparisons}" SelectedItem="{Binding SelectedComparison}"
                        AutoGenerateColumns="False" CanUserReorderColumns="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Source set" Binding="{Binding SourceSet}" Width="140"/>
                  <DataGridTextColumn Header="Target set" Binding="{Binding TargetSet}" Width="140"/>
                  <DataGridTemplateColumn Header="Match by" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:SetComparisonViewModel">
                        <ComboBox ItemsSource="{x:Static vm:MatchModes.Study}" SelectedItem="{Binding Match}" HorizontalAlignment="Stretch"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Plan label rules" Binding="{Binding LabelRules}" Width="2*"/>
                  <DataGridTextColumn Header="Field name rules" Binding="{Binding FieldRules}" Width="2*"/>
                  <DataGridTextColumn Header="Label overrides" Binding="{Binding Overrides}" Width="2*"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                <Button Content="Add comparison" Command="{Binding AddComparisonCommand}"/>
                <Button Content="Remove comparison" Command="{Binding RemoveComparisonCommand}"/>
                <Button Content="Use the AAA / AXB label rule" Command="{Binding SelectedComparison.UseAcrossAlgorithmsCommand}"
                        ToolTip.Tip="Sets the selected comparison's plan label rule to (AAA|AXB) -> {algorithm}"/>
              </StackPanel>

              <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Profile depths" VerticalAlignment="Center"/>
                <TextBox Text="{Binding DepthsText}" Width="260" ToolTip.Tip="For example: dmax, 15, 50, 100, 200, 300 mm (cm also accepted)"/>
                <TextBlock Text="Study file" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox Text="{Binding StudyFile}" Width="360" PlaceholderText="Path to a .json study file"/>
                <Button Content="Open" Command="{Binding OpenStudyCommand}"/>
                <Button Content="Save" Command="{Binding SaveStudyCommand}"/>
              </StackPanel>

              <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8">
                <Button Content="Preview pairing" Command="{Binding PreviewCommand}"/>
                <Button Content="Run study" Command="{Binding RunCommand}" Classes="accent"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
                <Button Content="Export study spreadsheets (CSV)" Command="{Binding ExportCommand}"/>
                <ProgressBar IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Width="140" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </TabItem>

          <TabItem Header="Pairing">
            <ListBox ItemsSource="{Binding PairingLines}" FontFamily="Cascadia Mono,Consolas,monospace"/>
          </TabItem>

          <TabItem Header="Results">
            <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Comparison" Binding="{Binding Comparison}" Width="*"/>
                <DataGridTextColumn Header="Patient" Binding="{Binding Facts.Patient}" Width="Auto"/>
                <DataGridTextColumn Header="Source plan" Binding="{Binding Facts.SourcePlan}" Width="Auto"/>
                <DataGridTextColumn Header="Target plan" Binding="{Binding Facts.TargetPlan}" Width="Auto"/>
                <DataGridTextColumn Header="Field" Binding="{Binding Facts.Field}" Width="Auto"/>
                <DataGridTextColumn Header="Machine" Binding="{Binding Facts.Machine}" Width="Auto"/>
                <DataGridTextColumn Header="Energy" Binding="{Binding Facts.Energy}" Width="Auto"/>
                <DataGridTextColumn Header="Field size" Binding="{Binding Facts.FieldSize}" Width="Auto"/>
                <DataGridTextColumn Header="Criterion" Binding="{Binding Criterion.Label}" Width="Auto"/>
                <DataGridTextColumn Header="Ambiguous" Binding="{Binding WorstOf}" Width="Auto"/>
                <DataGridTextColumn Header="Max used" Binding="{Binding MaximumUsed}" Width="Auto"/>
                <DataGridTextColumn Header="Edge check" Binding="{Binding EdgeCheck}" Width="Auto"/>
                <DataGridTextColumn Header="Pass %" Binding="{Binding PassRate, StringFormat=0.000}" Width="Auto"/>
                <DataGridTextColumn Header="Compared" Binding="{Binding Compared, StringFormat=N0}" Width="Auto"/>
                <DataGridTextColumn Header="Plan check" Binding="{Binding PlanCheck}" Width="*"/>
                <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings}" Width="*"/>
                <DataGridTextColumn Header="Failure" Binding="{Binding Failure}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Header="Index tables">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Comparison" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding IndexComparisons}" SelectedItem="{Binding SelectedIndexComparison}" MinWidth="220"/>
                <TextBlock Text="Criterion" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding IndexCriteria}" SelectedItem="{Binding SelectedIndexCriterion}" MinWidth="220"/>
                <TextBlock Text="Rows" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding RowAxis}" MinWidth="120"/>
                <TextBlock Text="Columns" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding ColumnAxis}" MinWidth="120"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{Binding Index.Title, FallbackValue='Run the study to see index tables.'}" TextWrapping="Wrap"/>
              <DataGrid Grid.Row="2" x:Name="IndexGrid" ItemsSource="{Binding IndexRows}" IsReadOnly="True"
                        AutoGenerateColumns="False" GridLinesVisibility="All"/>
            </Grid>
          </TabItem>

          <TabItem Header="Curves">
            <Grid RowDefinitions="Auto,2*,*,Auto" RowSpacing="6">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Field" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" MinWidth="420">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="studies:StudyField">
                      <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Curve" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" MinWidth="130"/>
                <TextBlock Text="Reference" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding ReferenceSets}" SelectedItem="{Binding ReferenceSet}" MinWidth="140"/>
                <TextBlock Text="Depths" VerticalAlignment="Center"/>
                <TextBox Text="{Binding DepthsText}" Width="200"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingCurves}" Width="100" VerticalAlignment="Center"/>
              </StackPanel>
              <sp:AvaPlot Grid.Row="1" x:Name="StudyCurvePlot"/>
              <sp:AvaPlot Grid.Row="2" x:Name="StudyDifferencePlot"/>
              <TextBlock Grid.Row="3" Text="{Binding CurveStatus}" TextWrapping="Wrap"/>
            </Grid>
          </TabItem>

          <TabItem Header="Log">
            <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace"/>
          </TabItem>
        </TabControl>
        <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </Grid>
    </Grid>
  </TabItem>

  <!-- Doses vs scans (crcrewso, 2026-11-17): its own doses and scans folders, a 1D criterion, and a run of the
       library's batch over every scan and every dose it pairs with, as DSCprofiles runs it. The table lists the pairs;
       the chosen pair's figure is drawn beside it by DSCplots.ProfilePlot (code-behind), the same figure saved. -->
  <TabItem Header="Doses vs scans" x:Name="ScansTab">
    <Grid DataContext="{Binding Scans}" x:DataType="vm:ScanComparisonViewModel"
          RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="6" Margin="6,12,6,12">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,220" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Doses" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DosesFolder}" PlaceholderText="Folder of RT Dose and RT Plan files (searched with its subfolders)"
                 ToolTip.Tip="Filled in from the Doses vs doses source folder until you choose a folder here"/>
        <Button Grid.Row="0" Grid.Column="2" Content="Browse" Command="{Binding BrowseDosesCommand}"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Plan label filter" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding PlanFilter}" PlaceholderText="regex, optional"
                 ToolTip.Tip="Only doses whose plan label matches this regular expression, ignoring case"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Scans" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScansFolder}" PlaceholderText="Folder of PTW mcc files (searched with its subfolders)"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Browse" Command="{Binding BrowseScansCommand}"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="Skip scan folders" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ExcludeFolders}" PlaceholderText="regex, for example ^zz"
                 ToolTip.Tip="Scan files under a folder whose name matches this regular expression are left out"/>
      </Grid>

      <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
        <TextBlock Text="Criterion" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Text="Dose %" VerticalAlignment="Center"/>
        <TextBox Text="{Binding DosePercent}" Width="60"/>
        <TextBlock Text="Distance mm" VerticalAlignment="Center"/>
        <TextBox Text="{Binding DistanceMm}" Width="60" ToolTip.Tip="0 with the strict test: dose difference only"/>
        <TextBlock Text="Test" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Tests}" SelectedItem="{Binding Test}" MinWidth="100"/>
        <TextBlock Text="Reference" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding References}" SelectedItem="{Binding Reference}" MinWidth="120"/>
        <CheckBox Content="Local" IsChecked="{Binding Local}" ToolTip.Tip="Dose difference as a percentage of the reference point, not of the reference maximum"/>
        <TextBlock Text="Cutoff %" VerticalAlignment="Center"/>
        <TextBox Text="{Binding CutoffPercent}" Width="60" ToolTip.Tip="Points below this percentage of the reference maximum aren't tested"/>
        <CheckBox Content="Depth shift" IsChecked="{Binding DepthShift}"
                  ToolTip.Tip="Depth doses only: read the dose at depth + s for s within 3 mm in 0.1 mm steps, the best fit beyond dmax"/>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Content="Run" Command="{Binding RunCommand}" Classes="accent"/>
          <Button Content="Cancel" Command="{Binding CancelCommand}"/>
          <ProgressBar IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Width="120" VerticalAlignment="Center"/>
        </StackPanel>
      </WrapPanel>

      <WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
        <TextBlock Text="Energy" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergy}" MinWidth="130" IsEnabled="{Binding HasResult}"/>
        <TextBlock Text="Field" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" MinWidth="220" IsEnabled="{Binding HasResult}"/>
        <TextBlock Text="Curve" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedCurve}" MinWidth="130" IsEnabled="{Binding HasResult}"/>
        <TextBlock Text="Show" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding Shows}" SelectedItem="{Binding Show}" MinWidth="130" IsEnabled="{Binding HasResult}"/>
        <TextBlock Text="{Binding Listed}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </WrapPanel>

      <Grid Grid.Row="3" ColumnDefinitions="5*,8,6*">
        <TabControl Grid.Column="0">
          <TabItem Header="Pairs">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True"
                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Row" Binding="{Binding Row}" Width="Auto"/>
                <DataGridTextColumn Header="Scan" Binding="{Binding Scan}" Width="300"/>
                <DataGridTextColumn Header="Curve" Binding="{Binding Curve}" Width="Auto"/>
                <DataGridTextColumn Header="Depth mm" Binding="{Binding Depth}" Width="Auto"/>
                <DataGridTextColumn Header="Energy" Binding="{Binding Energy}" Width="Auto"/>
                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="Auto"/>
                <DataGridTextColumn Header="Dose" Binding="{Binding DoseFile}" Width="260"/>
                <DataGridTextColumn Header="Pass %" Binding="{Binding PassRate}" Width="Auto"/>
                <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="Auto"/>
                <DataGridTextColumn Header="Max γ" Binding="{Binding MaxGamma}" Width="Auto"/>
                <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeText}" Width="Auto"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Unpaired">
            <ListBox ItemsSource="{Binding Unpaired}"/>
          </TabItem>
        </TabControl>
        <GridSplitter Grid.Column="1" Classes="sash" ResizeDirection="Columns" Width="8" Margin="0,4" ToolTip.Tip="Drag to resize the table and the figure"/>
        <!-- The chosen pair's figure: curves above, each tested point below. -->
        <sp:AvaPlot Grid.Column="2" x:Name="ScanPlot"/>
      </Grid>

      <WrapPanel Grid.Row="4" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
        <TextBlock Text="Format" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding PlotFormats}" SelectedItem="{Binding PlotFormat}" MinWidth="80"/>
        <Button Content="Save plot" Command="{Binding SavePlotCommand}"/>
        <Button Content="Save plots of listed pairs" Command="{Binding SaveListedPlotsCommand}"
                ToolTip.Tip="One image per pair the filters list, named by its row"/>
        <TextBlock Text="Plots in the export" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <ComboBox ItemsSource="{Binding PlotSelections}" SelectedItem="{Binding ExportPlots}" MinWidth="100"/>
        <Button Content="Export results (CSV)" Command="{Binding ExportCommand}"
                ToolTip.Tip="The files DSCprofiles writes: profiles-results.csv, profiles-unpaired.csv, profiles-settings.txt, and the plots in profiles-plots"/>
      </WrapPanel>

      <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="6" TextWrapping="Wrap" FontSize="11" Opacity="0.7">
        <Run Text="{Binding Details}"/>
        <LineBreak/>
        <Run Text="{Binding ConventionNote}"/>
      </TextBlock>
    </Grid>
  </TabItem>

  <!-- Its own tab since 2026-11-17 (crcrewso: "move it"): these settings serve every tab that compares doses. -->
  <!-- This machine's settings (MachineSettings, saved as they change). None changes a count. -->
  <TabItem Header="Settings">
    <StackPanel Margin="6,12,6,12" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock TextWrapping="Wrap" Text="Settings for this machine. They change how fast a comparison runs, never its counts, and are kept for this user on this machine, not in a study."/>
      <Grid ColumnDefinitions="160,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="Engine" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding EngineChoices}" SelectedItem="{Binding Engine}" MinWidth="160"
                  ToolTip.Tip="HandWritten is the original and the reference. The others apply the same rules faster and are tested to give the same counts."/>
        <TextBlock Grid.Row="1" Text="Threads" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ThreadChoices}" SelectedItem="{Binding Threads}" MinWidth="160"
                  ToolTip.Tip="CPU threads: within a pair for MultiThread, pairs at once for HandWritten and SingleThread. The recommended count is one per full-speed core, leaving out SMT siblings and low-power E-cores."/>
        <TextBlock Grid.Row="2" Text="Pairs at once" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PairsAtOnce}" Width="60" HorizontalAlignment="Left"
                 ToolTip.Tip="0 chooses from free memory: as many as half of it holds, up to the thread count (2 for the multi-thread and GPU engines)."/>
        <TextBlock Grid.Row="3" Text="Target box only" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding PartialTargetReads}"
                  ToolTip.Tip="Read each target only where the criteria and the edge check use it. A pair with a gamma criterion reads its target whole. The counts are the same either way."/>
        <TextBlock Grid.Row="4" Text="Readers" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Readers}" Width="60" HorizontalAlignment="Left"
                 ToolTip.Tip="Files read at once, ahead of the comparison; fewer if memory is short. 0 has each worker read its own pair."/>
        <TextBlock Grid.Row="5" Text="Held" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PairsHeld}" Width="60" HorizontalAlignment="Left"
                 ToolTip.Tip="Loaded pairs waiting for a worker, when Readers is above 0. Each held pair is two grids in memory."/>
      </Grid>
      <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Pairing"/>
      <TextBlock TextWrapping="Wrap" Text="Algorithm names change which doses pair, so they can change counts. A dose's algorithm is read from its plan label and beam name, else from its folder's Algorithm box; AAA pairs only with AAA, and a dose with none only with others that have none."/>
      <Grid ColumnDefinitions="160,*" ColumnSpacing="0">
        <TextBlock Text="Algorithm names" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding AlgorithmNames}"
                 ToolTip.Tip="Algorithm = token, token; ... Tokens are matched anywhere in a name, ignoring case."/>
      </Grid>
      <TextBlock Text="{Binding SettingsPath, StringFormat='Kept in {0}'}" TextWrapping="Wrap" Opacity="0.7"/>
    </StackPanel>
  </TabItem>
  </TabControl>
</Window>
