<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DSCprototypes.Shared.ViewModels"
        xmlns:shared="using:DSCprototypes.Shared"
        xmlns:graphs="using:DSCprototypes.Shared.Graphs"
        xmlns:studies="using:DSCprototypes.Shared.Studies"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="DSCproto.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DicomStrictCompare - Avalonia prototype"
        Width="1280" Height="820" MinWidth="900" MinHeight="600">

  <!-- Compiled bindings throughout: a typo in a binding path is a build error, not a blank control. -->

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <!-- Inputs: two folders, two aliases, the matching strategy -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,180" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Source (reference)" VerticalAlignment="Center"/>
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SourceFolder}" PlaceholderText="Folder of RT Dose and RT Plan files"/>
      <Button Grid.Row="0" Grid.Column="2" Content="Browse" Command="{Binding BrowseSourceCommand}"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Alias" VerticalAlignment="Center"/>
      <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SourceAlias}"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Target" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetFolder}" PlaceholderText="Folder of RT Dose and RT Plan files"/>
      <Button Grid.Row="1" Grid.Column="2" Content="Browse" Command="{Binding BrowseTargetCommand}"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Alias" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding TargetAlias}"/>

      <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Match doses by" VerticalAlignment="Center"/>
        <RadioButton Content="plan UID and beam number" IsChecked="{Binding MatchByUid}" GroupName="match"/>
        <RadioButton Content="patient, plan label and beam name" IsChecked="{Binding !MatchByUid}" GroupName="match"/>
      </StackPanel>
    </Grid>

    <!-- Work area: criteria on the left, results in tabs on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="340,8,*" Margin="0,12,0,0">

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Criteria" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <!-- "Max": what the threshold and global tolerance are fractions of. CAX falls back to Global Max unless
             the source plan's jaws are on axis; each result row says which was used. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <TextBlock Text="Max" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding MaximumChoices}" SelectedItem="{Binding Maximum}" MinWidth="130"
                    ToolTip.Tip="GlobalMax: the source grid's maximum. CaxMax: the 3 x 3 average at the CAX maximum (arcs: about the isocentre), used only when the source plan's jaws are on axis, otherwise Global Max."/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <Button Content="Add" Command="{Binding AddCriterionCommand}"/>
          <Button Content="Remove" Command="{Binding RemoveCriterionCommand}"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Criteria}" SelectedItem="{Binding SelectedCriterion}"
                  AutoGenerateColumns="False" CanUserReorderColumns="False" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tol %" Binding="{Binding TolerancePercent}" Width="*" MinWidth="70"/>
            <DataGridTextColumn Header="DTA mm" Binding="{Binding DistanceMm}" Width="*" MinWidth="90"/>
            <DataGridTextColumn Header="Thr %" Binding="{Binding ThresholdPercent}" Width="*" MinWidth="70"/>
            <DataGridCheckBoxColumn Header="Global" Binding="{Binding Global}" Width="Auto"/>
            <DataGridCheckBoxColumn Header="Gamma" Binding="{Binding Gamma}" Width="Auto"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- The splitter between criteria and results. Avalonia's default template is transparent, so
           the grab area was an invisible 8 px gap (Cody, 2026-11-09: "is there a way to make the part
           one can grab visible"). A light bar with a grip in the middle, the usual sash look. -->
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="8" Margin="0,4" ToolTip.Tip="Drag to resize the criteria panel">
        <GridSplitter.Template>
          <ControlTemplate>
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4">
              <Border Width="2" Height="36" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </Border>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <TabControl Grid.Column="2" x:Name="Tabs">
        <TabItem Header="Results">
          <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="2*"/>
              <DataGridTextColumn Header="Criterion" Binding="{Binding Criterion.Label}" Width="*"/>
              <DataGridTextColumn Header="Max used" Binding="{Binding MaximumUsed}" Width="Auto"/>
              <DataGridTextColumn Header="Compared" Binding="{Binding Compared, StringFormat=N0}" Width="Auto"/>
              <DataGridTextColumn Header="Failed" Binding="{Binding Failed, StringFormat=N0}" Width="Auto"/>
              <DataGridTextColumn Header="% failed" Binding="{Binding PercentFailed, StringFormat=0.000}" Width="Auto"/>
              <DataGridTextColumn Header="Max γ" Binding="{Binding MaxGamma, StringFormat=0.00}" Width="Auto"/>
              <DataGridTextColumn Header="Src MU" Binding="{Binding SourceMonitorUnits}" Width="Auto"/>
              <DataGridTextColumn Header="Tgt MU" Binding="{Binding TargetMonitorUnits}" Width="Auto"/>
              <DataGridTextColumn Header="s" Binding="{Binding ElapsedSeconds, StringFormat=0.0}" Width="Auto"/>
              <DataGridTextColumn Header="Failure" Binding="{Binding Failure}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Unmatched">
          <ListBox ItemsSource="{Binding Unmatched}"/>
        </TabItem>
        <TabItem Header="Log">
          <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace"/>
        </TabItem>
        <!-- Graphs (Cody, 2026-11-09): curves out of the matched pairs of the last run, filtered by energy
             and field size, a depth dose or a profile at a depth chosen with the slider. The view model
             owns the choice and the curve; this view only hands the curve to ScottPlot (code-behind). -->
        <TabItem Header="Graphs">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="6" Margin="0,6,0,0"
                DataContext="{Binding Graph}" x:DataType="vm:GraphViewModel">

            <!-- Mode: dose versus dose (the run's matched pairs) or dose versus water-tank scans -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Compare" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="170"/>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="120" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Dose versus dose: energy, field size, beam; curve kind and a fixed depth (or all of them) -->
            <StackPanel Grid.Row="1" Spacing="6" IsVisible="{Binding IsDoseMode}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Energy" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Energies}" SelectedItem="{Binding SelectedEnergy}" MinWidth="150" IsEnabled="{Binding HasBeams}"/>
                <TextBlock Text="Field size" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding FieldSizes}" SelectedItem="{Binding SelectedFieldSize}" MinWidth="150" IsEnabled="{Binding HasBeams}"/>
                <TextBlock Text="Beam" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Beams}" SelectedItem="{Binding SelectedBeam}" MinWidth="360" IsEnabled="{Binding HasBeams}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="graphs:BeamDescriptor">
                      <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Curve" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" MinWidth="150" IsEnabled="{Binding HasBeams}"/>
                <TextBlock Text="Depth" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox ItemsSource="{Binding DepthChoices}" SelectedItem="{Binding Depth}" MinWidth="130" IsEnabled="{Binding DepthEnabled}"/>
                <TextBlock Text="{Binding DepthText}" VerticalAlignment="Center" MinWidth="70"/>
                <TextBlock Text="Depths offered" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Text="{Binding DepthsText}" Width="220" ToolTip.Tip="For example: dmax, 15, 50, 100, 200, 300 mm (cm also accepted)"/>
              </StackPanel>
            </StackPanel>

            <!-- Dose versus scans: a folder of PTW mcc files, filters, the scan, and the dose it matched -->
            <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding IsScanMode}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Scans" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ScanFolder}" Width="520" PlaceholderText="Folder of PTW mcc files (searched with its subfolders)"/>
                <Button Content="Browse" Command="{Binding BrowseScansCommand}"/>
                <Button Content="Load scans" Command="{Binding LoadScansCommand}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Energy" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding ScanEnergies}" SelectedItem="{Binding SelectedScanEnergy}" MinWidth="150" IsEnabled="{Binding HasScans}"/>
                <TextBlock Text="Field size" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding ScanFieldSizes}" SelectedItem="{Binding SelectedScanFieldSize}" MinWidth="150" IsEnabled="{Binding HasScans}"/>
                <TextBlock Text="Scan" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Scans}" SelectedItem="{Binding SelectedScan}" MinWidth="420" IsEnabled="{Binding HasScans}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="graphs:ScanDescriptor">
                      <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Matched dose" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding DoseCandidates}" SelectedItem="{Binding SelectedDose}" MinWidth="560" IsEnabled="{Binding HasScans}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="graphs:DoseCandidate">
                      <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <sp:AvaPlot Grid.Row="3" x:Name="GraphPlot"/>
            <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="5" Text="{Binding ConventionNote}" TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>
          </Grid>
        </TabItem>
        <TabItem Header="Detector geometry">
          <TextBlock Margin="12" TextWrapping="Wrap"
                     Text="Placeholder: detector geometry correction for PTW scans. IDetectorCorrection exists in DSClibrary; no physical kernel is implemented yet (backlog D4), so there is nothing honest to switch on here."/>
        </TabItem>
        <TabItem Header="Archive">
          <TextBlock Margin="12" TextWrapping="Wrap"
                     Text="Placeholder: PNG export of each comparison for the record (an archiving output, not a display mechanism - Cody, 2026-11-08). Rendered from the retained ComparisonOutcome, independent of this window."/>
        </TabItem>

        <!-- Study (design/comparison-studies.md, 2026-11-14): several dose sets and the comparisons
             between them. F1 sets, F2 pairing rules and preview, F3/F4 checks on every row, F5 results
             and index tables, F7 every set's curves at the study's depths. Uses the Criteria list. -->
        <TabItem Header="Study">
          <Grid DataContext="{Binding Study}" x:DataType="vm:StudyViewModel" RowDefinitions="*,Auto" Margin="0,6,0,0">
            <TabControl Grid.Row="0">

              <TabItem Header="Setup">
                <Grid RowDefinitions="Auto,2*,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Text="Dose sets: a folder of RT Dose and RT Plan files each, under a name you choose" FontWeight="SemiBold"/>
                  <DataGrid Grid.Row="1" ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}"
                            AutoGenerateColumns="False" CanUserReorderColumns="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                      <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*"/>
                      <DataGridTextColumn Header="Algorithm" Binding="{Binding Algorithm}" Width="*"/>
                      <DataGridTextColumn Header="TPS" Binding="{Binding TpsVersion}" Width="*"/>
                      <DataGridTemplateColumn Header="Dose reported as" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="vm:DoseSetViewModel">
                            <ComboBox ItemsSource="{x:Static vm:DoseSetViewModel.ReportingChoices}" SelectedItem="{Binding Reporting}" HorizontalAlignment="Stretch"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Plan filter (regex)" Binding="{Binding PlanFilter}" Width="*"/>
                      <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add set" Command="{Binding AddSetCommand}"/>
                    <Button Content="Remove set" Command="{Binding RemoveSetCommand}"/>
                    <Button Content="Browse folder for the selected set" Command="{Binding BrowseSetFolderCommand}"/>
                  </StackPanel>

                  <TextBlock Grid.Row="3" Margin="0,8,0,0" FontWeight="SemiBold"
                             Text="Comparisons. Rules: 'pattern -> replacement; ...' (regular expressions). Overrides: 'source label = target label; ...'"/>
                  <DataGrid Grid.Row="4" ItemsSource="{Binding Comparisons}" SelectedItem="{Binding SelectedComparison}"
                            AutoGenerateColumns="False" CanUserReorderColumns="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Source set" Binding="{Binding SourceSet}" Width="140"/>
                      <DataGridTextColumn Header="Target set" Binding="{Binding TargetSet}" Width="140"/>
                      <DataGridCheckBoxColumn Header="By UID" Binding="{Binding MatchByUid}" Width="Auto"/>
                      <DataGridTextColumn Header="Plan label rules" Binding="{Binding LabelRules}" Width="2*"/>
                      <DataGridTextColumn Header="Field name rules" Binding="{Binding FieldRules}" Width="2*"/>
                      <DataGridTextColumn Header="Label overrides" Binding="{Binding Overrides}" Width="2*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add comparison" Command="{Binding AddComparisonCommand}"/>
                    <Button Content="Remove comparison" Command="{Binding RemoveComparisonCommand}"/>
                    <Button Content="Use the AAA / AXB label rule" Command="{Binding SelectedComparison.UseAcrossAlgorithmsCommand}"
                            ToolTip.Tip="Sets the selected comparison's plan label rule to (AAA|AXB) -> {algorithm}"/>
                  </StackPanel>

                  <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Profile depths" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DepthsText}" Width="260" ToolTip.Tip="For example: dmax, 15, 50, 100, 200, 300 mm (cm also accepted)"/>
                    <TextBlock Text="Study file" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBox Text="{Binding StudyFile}" Width="360" PlaceholderText="Path to a .json study file"/>
                    <Button Content="Open" Command="{Binding OpenStudyCommand}"/>
                    <Button Content="Save" Command="{Binding SaveStudyCommand}"/>
                  </StackPanel>

                  <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8">
                    <Button Content="Preview pairing" Command="{Binding PreviewCommand}"/>
                    <Button Content="Run study" Command="{Binding RunCommand}" Classes="accent"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}"/>
                    <Button Content="Export study spreadsheets (CSV)" Command="{Binding ExportCommand}"/>
                    <ProgressBar IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Width="140" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </TabItem>

              <TabItem Header="Pairing">
                <ListBox ItemsSource="{Binding PairingLines}" FontFamily="Cascadia Mono,Consolas,monospace"/>
              </TabItem>

              <TabItem Header="Results">
                <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Comparison" Binding="{Binding Comparison}" Width="*"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding Facts.Patient}" Width="Auto"/>
                    <DataGridTextColumn Header="Source plan" Binding="{Binding Facts.SourcePlan}" Width="Auto"/>
                    <DataGridTextColumn Header="Target plan" Binding="{Binding Facts.TargetPlan}" Width="Auto"/>
                    <DataGridTextColumn Header="Field" Binding="{Binding Facts.Field}" Width="Auto"/>
                    <DataGridTextColumn Header="Machine" Binding="{Binding Facts.Machine}" Width="Auto"/>
                    <DataGridTextColumn Header="Energy" Binding="{Binding Facts.Energy}" Width="Auto"/>
                    <DataGridTextColumn Header="Field size" Binding="{Binding Facts.FieldSize}" Width="Auto"/>
                    <DataGridTextColumn Header="Criterion" Binding="{Binding Criterion.Label}" Width="Auto"/>
                    <DataGridTextColumn Header="Max used" Binding="{Binding MaximumUsed}" Width="Auto"/>
                    <DataGridTextColumn Header="Pass %" Binding="{Binding PassRate, StringFormat=0.000}" Width="Auto"/>
                    <DataGridTextColumn Header="Compared" Binding="{Binding Compared, StringFormat=N0}" Width="Auto"/>
                    <DataGridTextColumn Header="Plan check" Binding="{Binding PlanCheck}" Width="*"/>
                    <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings}" Width="*"/>
                    <DataGridTextColumn Header="Failure" Binding="{Binding Failure}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>

              <TabItem Header="Index tables">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Comparison" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding IndexComparisons}" SelectedItem="{Binding SelectedIndexComparison}" MinWidth="220"/>
                    <TextBlock Text="Criterion" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding IndexCriteria}" SelectedItem="{Binding SelectedIndexCriterion}" MinWidth="220"/>
                    <TextBlock Text="Rows" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding RowAxis}" MinWidth="120"/>
                    <TextBlock Text="Columns" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding ColumnAxis}" MinWidth="120"/>
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="{Binding Index.Title, FallbackValue='Run the study to see index tables.'}" TextWrapping="Wrap"/>
                  <DataGrid Grid.Row="2" x:Name="IndexGrid" ItemsSource="{Binding IndexRows}" IsReadOnly="True"
                            AutoGenerateColumns="False" GridLinesVisibility="All"/>
                </Grid>
              </TabItem>

              <TabItem Header="Curves">
                <Grid RowDefinitions="Auto,2*,*,Auto" RowSpacing="6">
                  <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Field" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" MinWidth="420">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="studies:StudyField">
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Curve" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" MinWidth="130"/>
                    <TextBlock Text="Reference" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ReferenceSets}" SelectedItem="{Binding ReferenceSet}" MinWidth="140"/>
                    <TextBlock Text="Depths" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DepthsText}" Width="200"/>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingCurves}" Width="100" VerticalAlignment="Center"/>
                  </StackPanel>
                  <sp:AvaPlot Grid.Row="1" x:Name="StudyCurvePlot"/>
                  <sp:AvaPlot Grid.Row="2" x:Name="StudyDifferencePlot"/>
                  <TextBlock Grid.Row="3" Text="{Binding CurveStatus}" TextWrapping="Wrap"/>
                </Grid>
              </TabItem>

              <TabItem Header="Log">
                <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace"/>
              </TabItem>
            </TabControl>
            <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Actions and status -->
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Run comparison" Command="{Binding RunCommand}" Classes="accent"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        <Button Content="Export spreadsheet (CSV)" Command="{Binding ExportCommand}"/>
      </StackPanel>
      <ProgressBar DockPanel.Dock="Right" IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Width="160" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
