<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia prototype, in Avalonia's own idiom: XAML views with compiled bindings (the default in
    Avalonia 12), a view model per view (CommunityToolkit.Mvvm), platform services reached through the
    TopLevel (the folder picker), and nothing drawn by the view model. Cross-platform: the same exe
    runs on Windows, Linux and macOS, so the Linux DSC session can run it too. crane-dsc, 2026-11-08.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DSCproto.AvaloniaApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSCprototypes.Shared\DSCprototypes.Shared.csproj" />
  </ItemGroup>

</Project>
